# HomeMate customer app — configuration.
#
# Flutter has no runtime .env: a web build is downloadable, so anything bundled
# as an asset is public. These are passed as compile-time --dart-define values
# instead. Nothing here is secret; the session token is the only credential the
# app holds, and it is issued at sign-in.
#
# Usage:
#   flutter run   -d chrome --dart-define-from-file=.env.json
#   flutter build web        --dart-define-from-file=.env.json
#
# Copy this to .env.json as JSON (Flutter reads JSON, not KEY=VALUE):
#   {"API_BASE_URL": "http://localhost:3001", ...}

API_BASE_URL=http://localhost:3001
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_USER_AGENT=tz.co.homemate.app
DEFAULT_LATITUDE=-6.7924
DEFAULT_LONGITUDE=39.2083
REQUEST_TIMEOUT_SECONDS=20
